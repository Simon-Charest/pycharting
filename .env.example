# Copy this file to .env and set your own values. Never commit .env.
# Every setting is required. True or false settings accept true or false.

# Encrypted SQLite (SQLCipher) database file, relative to the repository root.
DATABASE_FILE=data/database.sqlite

# Encryption password. The data cannot be recovered without it.
DATABASE_PASSWORD=change-me

# Web API address.
API_HOST=127.0.0.1
API_PORT=80

# Optional: other addresses allowed to call the Web API, comma-separated (e.g. the public address).
API_ORIGINS=

# Restart the Web API when the code changes. For development only.
API_RELOAD=false

# Seconds before giving up on a request to PriceCharting or the Bank of Canada.
REQUEST_TIMEOUT=30

# Deployment (bin/deploy.ps1): SSH account and server, folder of the clone there, systemd service and Git repository.
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PASSWORD=
DEPLOY_DIR=~/source/pycharting
DEPLOY_REPOSITORY=https://github.com/Simon-Charest/pycharting.git
DEPLOY_SERVICE=pycharting.service

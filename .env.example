# Copy this file to .env and set your own values. Never commit .env.
# Every setting is required. True or false settings accept true or false.

# Encrypted SQLite (SQLCipher) database file, relative to the repository root.
DATABASE_FILE=pycharting/db/database.sqlite

# Encryption password. The data cannot be recovered without it.
DATABASE_PASSWORD=change-me

# Web API address.
API_HOST=127.0.0.1
API_PORT=80

# Restart the Web API when the code changes. For development only.
API_RELOAD=false

# Crawler: exclude game reproductions and virtual games.
EXCLUDE_REPRODUCTION=true

# Crawler: exclude unowned games.
EXCLUDE_UNOWNED=true

# Crawler: sanitize console and game names for PriceCharting.
SANITIZE=true

# Crawler: seconds to wait between two requests to PriceCharting.
SECONDS=0.4

# Crawler: print data during processing.
VERBOSE=true

# Seconds before giving up on a Web request.
REQUEST_TIMEOUT=30

# Reports: comma-separated keys to convert from USD to CAD, and keys to leave out of the conversion.
INCLUDED_KEYS=min,avg,max,sum
EXCLUDED_KEYS=count
